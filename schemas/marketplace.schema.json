{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agile Agentic Analytics Canonical Marketplace Catalog",
  "type": "object",
  "required": ["marketplace", "defaults", "plugins"],
  "additionalProperties": false,
  "properties": {
    "marketplace": {
      "type": "object",
      "required": ["name", "displayName", "description", "version", "owner", "repository"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "owner": { "type": "object" },
        "repository": { "type": "string", "format": "uri" }
      }
    },
    "defaults": { "type": "object" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "plugin.schema.json" }
    }
  }
}
